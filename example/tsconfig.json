{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": "..",
    "paths": {
      "mioku": ["packages/mioku/src/index.ts"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["**/node_modules", "**/venv", "**/.venv", "**/dist"]
}