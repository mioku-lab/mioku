{
  "name": "mioku",
  "type": "module",
  "version": "1.0.9",
  "packageManager": "bun@1.2.0",
  "description": "Mioku - A plugin-based QQ bot framework",
  "keywords": [
    "onebot",
    "framework",
    "bot",
    "mioku"
  ],
  "bin": {
    "mioku": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">= 22.18.0"
  },
  "homepage": "https://github.com/mioku-lab/mioku#readme",
  "files": [
    "dist"
  ],
  "bugs": {
    "url": "https://github.com/mioku-lab/mioku/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mioku-lab/mioku.git",
    "directory": "packages/mioku"
  },
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "author": "Jerryplusy <jerryplusy@outlook.com>",
  "license": "MIT",
  "dependencies": {
    "napcat-sdk": "^0.16.0",
    "consola": "^3.4.2",
    "dayjs": "^1.11.19",
    "dedent": "^1.7.1",
    "filesize": "^11.0.13",
    "inquirer": "^10.0.0",
    "jiti": "^2.6.1",
    "lowdb": "^7.0.1",
    "mri": "^1.2.0",
    "node-cron": "^4.2.1",
    "pretty-ms": "^9.3.0",
    "string2argv": "^1.0.2",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@types/node": "^22.0.0",
    "tsdown": "^0.11.0",
    "typescript": "^5.8.0"
  }
}
