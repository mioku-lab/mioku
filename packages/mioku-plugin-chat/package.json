{
  "name": "mioku-plugin-chat",
  "version": "3.0.3",
  "description": "AI 智能聊天插件",
  "main": "index.ts",
  "type": "module",
  "keywords": [
    "mioku"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mioku-lab/mioku.git"
  },
  "mioku": {
    "services": [
      "ai",
      "config",
      "help",
      "screenshot"
    ],
    "accessHooks": [
      {
        "id": "戳一戳触发对话",
        "event": "notice.group.poke",
        "description": "群内戳一戳 bot"
      }
    ],
    "help": {
      "title": "AI 聊天",
      "description": "智能 AI 聊天插件",
      "commands": [
        {
          "cmd": "/重置会话",
          "desc": "重置自己的AI聊天记录",
          "role": "member"
        },
        {
          "cmd": "/重置群会话",
          "desc": "重置当前群的AI聊天记录",
          "role": "admin"
        },
        {
          "cmd": "/tts <文本>",
          "desc": "TTS 推理",
          "role": "owner"
        }
      ]
    }
  },
  "dependencies": {
    "openai": "^4.0.0",
    "puppeteer": "^23.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "mioku": "workspace:*",
    "mioku-service-audio": "workspace:*"
  },
  "peerDependencies": {
    "mioku": "^1.0.0"
  }
}
