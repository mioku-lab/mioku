{
  "name": "mioku-adapter-icqq",
  "type": "module",
  "version": "1.2.2",
  "description": "icqq adapter for mioku.",
  "keywords": [
    "mioku"
  ],
  "engines": {
    "node": ">= 22.18.0"
  },
  "files": [
    "dist",
    "vendor/icqq"
  ],
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown"
  },
  "bin": {
    "mioku-adapter-icqq": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vendor/icqq": {
      "types": "./vendor/icqq/lib/index.d.ts",
      "import": "./vendor/icqq/lib/index.mjs",
      "require": "./vendor/icqq/lib/index.js",
      "default": "./vendor/icqq/lib/index.mjs"
    },
    "./vendor/icqq/package.json": "./vendor/icqq/package.json",
    "./cli": {
      "require": "./dist/cli.cjs",
      "import": "./dist/cli.mjs"
    },
    "./package.json": "./package.json"
  },
  "author": "Jerryplusy",
  "license": "MIT",
  "peerDependencies": {
    "mioku": "^1.0.0"
  },
  "dependencies": {
    "axios": "1.19.0",
    "consola": "^3.4.2",
    "log4js": "^6.9.1",
    "pngjs": "^7.0.0",
    "probe-image-size": "^7.2.3",
    "protobufjs": "^6.10.0",
    "silk-wasm": "^3.6.1",
    "triptrap": "^0.0.17",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.8",
    "mioku": "workspace:*",
    "tsdown": "^0.18.4",
    "typescript": "^5.9.3"
  }
}
